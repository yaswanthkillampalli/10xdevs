PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/10xdevss
ALLOWED_ORIGINS=http://localhost:5173

# Use separate secrets in production. JWT_SECRET is a supported fallback.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_AUTH_TTL_SECONDS=600
